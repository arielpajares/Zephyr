# Application
APP_NAME="Zephyr Dev Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bitnet
DB_USERNAME=bitnet
DB_PASSWORD=bitnet123
DB_ROOT_PASSWORD=root

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@zephyr.local
MAIL_FROM_NAME="${APP_NAME}"

# Magic Link
MAGIC_LINK_EXPIRE_MINUTES=15

# Docker Configuration
CONTAINER_PREFIX=zephyr
NETWORK_NAME=zephyr

# Service Ports
WEB_PORT=8000
DB_PORT_EXTERNAL=3306
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025

# Versions
MYSQL_VERSION=8.0
NODE_VERSION=20

# Important Next.JS
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=America/Montevideo

#GROQ App Key
GROQ_API_KEY=
